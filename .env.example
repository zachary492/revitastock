# Supabase — from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only, never expose to the client

# eBay Developer credentials — from developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=                       # the "Redirect URL name" from Your Account > Application Keys > User Tokens — NOT a raw URL
EBAY_REDIRECT_URI=http://localhost:3000/api/ebay/oauth/callback
EBAY_ENV=sandbox                  # sandbox | production
